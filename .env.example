# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=assetdb

# 백엔드 서버 설정
NODE_ENV=development
SERVER_PORT=3001
# 선택사항: PM2 또는 일부 환경에서 사용하는 대체 포트 변수
PORT=3001

# Vite 프론트엔드 설정
VITE_PORT=5173
VITE_API_URL=http://localhost:3001

# 구글 백업 설정 (OAuth 2.0)
# 1단계: Google Cloud Console에서 프로젝트 생성
# 2단계: Google Drive & Sheets API 활성화
# 3단계: OAuth 2.0 클라이언트 ID 생성 (웹 애플리케이션 또는 기타)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_BACKUP_FOLDER_ID=your_google_drive_folder_id_for_backups

# 선택사항: 백업 파일의 소유권을 이전할 이메일 주소
GOOGLE_PERSONAL_EMAIL=your-email@gmail.com
# 선택사항: 기본값(http://localhost:3000/oauth2callback)과 다른 경우 사용할 리다이렉트 URI
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
