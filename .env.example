# =================================================================
# Docker & 로컬 실행용 환경 변수 설정 템플릿
# =================================================================

# 애플리케이션 접속 포트 (기본: http://localhost:3000)
APP_PORT=3000

# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=3306
DB_EXTERNAL_PORT=3306
DB_USER=root
DB_PASSWORD=root1234
DB_NAME=assetdb

# Google Sheets 백업 연동 (선택 사항)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
