{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:backend": "cd backend && nodemon --watch . --watch .. server.js",
    "dev:frontend": "vite",
    "test": "vitest run && npm run test:backend",
    "test:frontend": "vitest",
    "test:backend": "cd backend && npm test",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm install && cd backend && npm install",
    "postinstall": "cd backend && npm install",
    "build:all": "npm run build && cd backend && npm install --omit=dev",
    "start": "cd backend && NODE_ENV=production node server.js",
    "db:sync": "node backend/scripts/sync-db-schema.js",
    "deploy": "npm run build && sudo cp -r dist/* /var/www/asdb/ && sudo systemctl reload nginx",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop all",
    "pm2:status": "pm2 list",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.3.7",
    "nodemon": "^3.1.11",
    "pm2": "^6.0.14",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.18",
    "vue": "^3.5.27"
  }
}